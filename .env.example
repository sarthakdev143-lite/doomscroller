# ===== App =====
APP_ENV=dev
USE_MOCK=false
LOG_LEVEL=INFO

# ===== Database =====
# Leave blank to use local SQLite at ./doomscroller.db
DATABASE_URL=

# ===== Scheduler (autonomous mode) =====
# How often to scrape new content
SCRAPE_INTERVAL_HOURS=6
SCRAPE_MAX_PER_RUN=20
# How often to discover new creators from engagement graphs
DISCOVERY_INTERVAL_HOURS=24
# Upload cadence — 3 per day, 8h apart (conservative, shadowban-safe)
UPLOADS_PER_DAY=3
UPLOAD_INTERVAL_HOURS=8
# Min items to keep in the approved queue (otherwise wait before publishing)
MIN_APPROVED_QUEUE=1
# Auto-publish: if true, scheduler auto-publishes next transformed video at each slot
AUTO_PUBLISH=true

# ===== Scraping =====
# JSON array of seed handles, e.g. ["@creator1","@creator2"]
TARGET_HANDLES=["@khaby.lame","@charlidamelio","@mrbeast"]
# JSON array of seed hashtags
TARGET_HASHTAGS=["reels","shorts","viral","trending","entertainment","spotlight"]
# Platforms to scrape. Order does not matter; source priority is set in tasks/pipeline.py
ENABLED_PLATFORMS=["instagram","snapchat","youtube"]
# Optional HTTP(S) proxy for yt-dlp / Playwright
PROXY_URL=
# Optional browser cookie export for yt-dlp Instagram/Reels access.
# Windows DPAPI issues are common; leave empty unless you have a working export.
COOKIES_FROM_BROWSER=

# ===== Storage =====
# Where downloaded source videos are stored
CONTENT_DIR=./content
# Max age in days for downloaded source videos (cleanup)
SOURCE_VIDEO_MAX_AGE_DAYS=7

# ===== Video transformation =====
TRANSFORM_WIDTH=1080
TRANSFORM_HEIGHT=1920
TRANSFORM_BLUR_SIGMA=20
TRANSFORM_CAPTION_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ===== YouTube publishing =====
# Path to OAuth client secrets JSON (download from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_PATH=./secrets/youtube_token.json
MAX_UPLOADS_PER_DAY=50
YOUTUBE_DEFAULT_TITLE=Shorts
YOUTUBE_DEFAULT_TAGS=["shorts","viral"]
YOUTUBE_DEFAULT_CATEGORY=22
YOUTUBE_DEFAULT_PRIVACY=private
# Channel niche (general_viral|tech|comedy|education) — affects LLM prompt
CHANNEL_NICHE=general_viral

# ===== LLM metadata generation =====
# Uses z-ai CLI (in-house, free). Set to false to use rule-based fallback.
USE_LLM_METADATA=true
LLM_MODEL=glm-4-plus
LLM_TIMEOUT_SEC=60

# ===== Dashboard =====
DASHBOARD_TITLE=Doomscroller

# ===== Legacy Celery (optional, for distributed mode) =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1