# ===== App =====
APP_ENV=dev
USE_MOCK=false
LOG_LEVEL=INFO

# ===== Database =====
# Leave blank to use local SQLite at ./doomscroller.db
DATABASE_URL=

# ===== Scheduler (8/day jitter, 20 pending target) =====
SCRAPE_INTERVAL_HOURS=6
SCRAPE_MAX_PER_RUN=20
SCRAPE_TARGET_PENDING=20
DISCOVERY_INTERVAL_HOURS=24
AUTO_DISCOVERY=false
UPLOADS_PER_DAY=8
UPLOAD_INTERVAL_HOURS=3
UPLOAD_JITTER_MINUTES=45
MIN_APPROVED_QUEUE=1
AUTO_PUBLISH=false
ENABLE_PUBLISH=true
# Unattended curation. Videos are held for AUTO_APPROVE_VETO_HOURS after being
# scraped so a human can still reject them; set 0 to approve immediately.
AUTO_APPROVE=false
AUTO_APPROVE_VETO_HOURS=1
AUTO_APPROVE_MIN_VIRAL_SCORE=0.45

# ===== Scraping (Snapchat Spotlight) =====
# Spotlight is crawled over plain HTTP by reading the __NEXT_DATA__ payload the
# page already embeds -- no browser needed. Playwright is only a fallback.
# Handles are bare Snapchat usernames (no leading @); they are scraped in
# addition to Spotlight, and each costs one extra request per video.
TARGET_HANDLES=[]
# Spotlight has no public hashtag index, so these RANK the crawled feed against
# Snapchat's own keywords rather than querying it.
TARGET_HASHTAGS=["viral","trending","funny","dance","entertainment"]
ENABLED_PLATFORMS=["snapchat"]

# --- Channel focus ---
# A channel posting six languages teaches the recommender nothing about who to
# show it to. Empty list accepts every language.
TARGET_LANGUAGES=["en"]
ALLOW_UNKNOWN_LANGUAGE=false
# Optional topic allowlist / blocklist, matched against the platform keywords,
# title and description. Empty accepts every topic.
TARGET_TOPICS=[]
EXCLUDED_TOPICS=[]

# --- Candidate filtering (applied to metadata BEFORE anything is downloaded) ---
# Absolute view floor. Spotlight is already algorithmically filtered upstream,
# so reach is a better gate there than engagement rate.
VIRAL_MIN_VIEWS=25000
# Engagement-rate gates, used for non-Snapchat sources.
VIRAL_MIN_ENGAGEMENT=0.15
VIRAL_MIN_VELOCITY=0.12
# Source shape. Anything outside these is rejected before download.
MIN_SOURCE_DURATION_SEC=3
MAX_SOURCE_DURATION_SEC=179
MIN_SOURCE_HEIGHT=480
MIN_FILE_SIZE_BYTES=50000

# Optional HTTP(S) proxy
PROXY_URL=
# Optional browser cookie export for yt-dlp (secondary platforms only).
# Windows DPAPI issues are common; leave empty unless you have a working export.
COOKIES_FROM_BROWSER=

# ===== Storage =====
# Where downloaded source videos are stored
CONTENT_DIR=./content
# Max age in days for downloaded source videos (cleanup)
SOURCE_VIDEO_MAX_AGE_DAYS=7

# ===== Video transformation =====
TRANSFORM_WIDTH=1080
TRANSFORM_HEIGHT=1920
TRANSFORM_BLUR_SIGMA=20
# Leave blank to autodetect a bold system font. A path that does not exist
# would make every render fail, so a bad value falls back to autodetect.
TRANSFORM_CAPTION_FONT=

# --- Output differentiation ---
# Republishing someone else's clip verbatim is what YouTube's reused-content
# policy targets. These make each upload genuinely different, and different
# from each other (parameters are drawn per video, seeded by its id).
# NOTE: this reduces the risk, it does not make the content original. A channel
# built on other people's videos may still fail monetisation review.
TRANSFORM_VARIATION=true
# Corner watermark text. Blank disables it.
BRAND_NAME=
BRAND_WATERMARK_OPACITY=0.45
# Burn a hook caption over the opening seconds. Off by default: Spotlight clips
# usually already carry the creator's own captions plus Snapchat's attribution,
# so a third text layer reads as clutter. Turn on for clean sources.
CAPTION_ENABLED=false
CAPTION_SECONDS=3.0
CAPTION_MAX_CHARS=42
# Subscribe end card, overlaid over the closing seconds (never appended, so it
# adds no duration).
END_CARD_ENABLED=true
END_CARD_SECONDS=2.0
END_CARD_TEXT=Subscribe for more
# Per-video jitter ranges.
ZOOM_MIN=1.02
ZOOM_MAX=1.08
SPEED_MIN=0.97
SPEED_MAX=1.04
# Sharpen after upscaling (Spotlight sources are commonly 540x960).
UPSCALE_SHARPEN=true
# Trim bands off the top/bottom of the source, as a percentage of height.
# Spotlight clips have Snapchat branding and the original creator handle burned
# into those bands. Cropping gives a cleaner Short but removes the platform's
# visible attribution, leaving only the description credit. Off by default.
SOURCE_CROP_TOP_PCT=0
SOURCE_CROP_BOTTOM_PCT=0

# ===== YouTube publishing =====
# Path to OAuth client secrets JSON (download from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_PATH=./secrets/youtube_token.json
MAX_UPLOADS_PER_DAY=50
YOUTUBE_DEFAULT_TITLE=Shorts
YOUTUBE_DEFAULT_TAGS=["shorts","viral"]
YOUTUBE_DEFAULT_CATEGORY=22
YOUTUBE_DEFAULT_PRIVACY=private
# Channel niche (general_viral|tech|comedy|education) — affects LLM prompt
CHANNEL_NICHE=general_viral

# ===== Metadata generation =====
# Titles/descriptions/tags come from the best source available, in order:
#   1. platform  - Snapchat's own SEO copy (llmTitle/llmDescription/keywords).
#                  Free, already written for search, in the source language.
#   2. llm       - the `z-ai` CLI, only if that binary is on PATH.
#   3. fallback  - rule-based composition.
# Leaving this true is harmless when z-ai is absent: step 1 covers Spotlight and
# step 3 covers everything else.
USE_LLM_METADATA=true
LLM_MODEL=glm-4-plus
LLM_TIMEOUT_SEC=60

# ===== Dashboard =====
DASHBOARD_TITLE=Doomscroller

# ===== Legacy Celery (optional, for distributed mode) =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1